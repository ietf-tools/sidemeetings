DATABASE_URL=postgresql://user:password@localhost:5432/sidemeetings
SESSION_SECRET=change-me-to-a-random-32-char-string
FRONTEND_URL=http://localhost:3000
BACKEND_PORT=4000
NODE_ENV=development

# Apply pending Drizzle migrations on startup. Handy for single-container
# deployments; leave unset if migrations run as a separate job/step.
AUTO_MIGRATE=false

# Seed an initial admin (email, name "Administrator") on first startup when the
# users table is empty, so the first deployment has someone who can log in.
SETUP_ADMIN_EMAIL=

# OAuth2
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER_URL=https://authentik.example.com/application/o/sidemeetings/
OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/callback

# Email / SMTP
# Email notifications are sent on submission, approval and rejection. Leave
# SMTP_HOST unset to disable sending (submissions still work; sends are skipped).
# The From address and Reply-To are configured in the admin Settings page;
# SMTP_FROM is the fallback From when Settings has none. Approver recipients are
# the addresses listed under Settings → Approvers.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set to false to skip TLS certificate validation (self-signed/mismatched
# certs). Insecure — use only on trusted staging relays.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Nuxt
NUXT_PUBLIC_API_URL=http://localhost:4000/api
