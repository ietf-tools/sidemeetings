{
  "name": "sidemeetings",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NUXT_PUBLIC_API_URL=${NUXT_PUBLIC_API_URL:-/api} nuxt generate",
    "start": "node backend/index.js",
    "dev:frontend": "nuxt dev",
    "build:frontend": "nuxt generate",
    "preview:frontend": "nuxt preview",
    "dev:backend": "node --watch backend/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio --port 8000 --host 0.0.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/sensible": "6.0.4",
    "@fastify/session": "11.1.1",
    "@fastify/static": "9.1.3",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "5.2.6",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.9.0",
    "nodemailer": "7.0.13",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "6.14.0",
    "@pinia/nuxt": "0.11.3",
    "drizzle-kit": "0.31.10",
    "lucide-vue-next": "1.0.0",
    "nuxt": "4.4.8",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "pinia": "3.0.4",
    "pino-pretty": "13.1.3",
    "temporal-polyfill": "1.0.1"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "@parcel/watcher": false
  }
}
