{
  "name": "sidemeetings",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon -x 'node --env-file=.env' backend/index.js --dev",
    "dev:client": "vite",
    "build": "vite build",
    "db-generate": "drizzle-kit generate --dialect=postgresql --schema=./backend/db/schema.js --out=./backend/db/migrations --name=main",
    "db-up": "drizzle-kit up --dialect=postgresql --out=./backend/db/migrations"
  },
  "dependencies": {
    "@fastify/compress": "9.0.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/http-proxy": "11.5.0",
    "@fastify/sensible": "6.0.4",
    "@fastify/static": "9.1.3",
    "@fastify/vite": "9.1.0",
    "@tailwindcss/vite": "4.3.1",
    "@vitejs/plugin-vue": "6.0.7",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "ical-generator": "11.0.0",
    "pg": "8.22.0",
    "tailwindcss": "4.3.1",
    "vite": "8.1.0",
    "vite-plugin-vue-devtools": "8.1.3",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@headlessui/vue": "1.7.23",
    "@heroicons/vue": "2.2.0",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "globals": "17.7.0",
    "luxon": "3.7.2",
    "nodemon": "3.1.14",
    "npm-run-all2": "9.0.2",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
