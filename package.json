{
  "name": "sidemeetings",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NUXT_PUBLIC_API_URL=${NUXT_PUBLIC_API_URL:-/api} nuxt generate",
    "start": "node backend/index.js",
    "dev:frontend": "nuxt dev",
    "build:frontend": "nuxt generate",
    "preview:frontend": "nuxt preview",
    "dev:backend": "node --watch backend/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio --port 8000 --host 0.0.0.0",
    "ncu": "ncu -i"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/sensible": "6.0.5",
    "@fastify/session": "11.1.2",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "nodemailer": "9.0.5",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@lucide/vue": "1.34.0",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@pinia/nuxt": "1.0.2",
    "drizzle-kit": "0.31.10",
    "npm-check-updates": "23.1.0",
    "nuxt": "4.5.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "pinia": "4.0.3",
    "pino-pretty": "13.1.3",
    "temporal-polyfill": "1.0.4"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher": false
  }
}
